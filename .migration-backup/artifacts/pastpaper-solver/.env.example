# Connect a PostgreSQL database that is reachable from Vercel.
DATABASE_URL=

# Set a strong password for the single administrator account.
ADMIN_PASSWORD=

# Generate once with: openssl rand -base64 48
# Keep this value stable; it signs admin sessions and encrypts saved AI keys.
SESSION_SECRET=

# Create a private Vercel Blob store and add its read/write token.
BLOB_READ_WRITE_TOKEN=

# Optional server-side AI configuration. Alternatively, enter the key in Admin > AI settings.
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini
AI_API_KEY=
